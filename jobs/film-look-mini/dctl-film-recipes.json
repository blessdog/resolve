{
  "about": "Film emulation recipes built only from Thatcher Freeman's utility-dctls (blessdog/utility-dctls @ 693bf81), following its README pipeline: Clamp 0+, Film Curve negative, printer-lights gain holding 0.18, Film Curve print, display encoding by Resolve colour management. Setting names are the DCTLs' own UI names. 'solve' is filled by film_chain.solve_gain. Writer: the agent, from measured renders and Ryan's verdicts. Reader: dctl_film_mini.py.",
  "approved": {
    "recipe": "rich-halation-grain-400",
    "by": "Ryan",
    "on": "2026-09-12",
    "words": "img-0006-rich-halation-grain-400.mp4 looks good",
    "claim": "knowledge/ryan-approved-the-utility-dctls-film-look-with-400-grain.md"
  },
  "inputs": {
    "dji-action5-dlogm": {
      "why": "Resolve 21.1 colour management has no D-Log M input, and the clip is tagged bt709, so Resolve would linearise the log as Rec.709. The clip input is set to 'Linear' (Rec.709 primaries, linear gamma), which equals the Rec.709 / Linear timeline, so the code values reach the Fusion comp untouched. Then Thatcher Freeman's D-Log M DCTL (dwg-transforms @ 22f2134, fit to Action 5 footage) outputs linear DaVinci Wide Gamut, and Gamut Primaries Conversion (utility-dctls @ 693bf81) takes it to Rec.709, the space the approved look was built in.",
      "clip_input": "Linear",
      "stages": [
        {
          "dctl": "DJI Action 5 D-Log M to DWG",
          "role": "d-log m to linear dwg",
          "params": {
            "Output Transfer Function": 1,
            "Output Color Gamut": 0
          }
        },
        {
          "dctl": "Gamut Primaries Conversion",
          "role": "dwg to rec709",
          "params": {
            "Working Primaries": 6,
            "Target Primaries": 10,
            "Direction": 0,
            "Chromatic Adaptation": 1
          }
        }
      ]
    },
    "dji-action5-dlogm-di": {
      "why": "Same D-Log M DCTL, but left in DaVinci Wide Gamut / DaVinci Intermediate (log) instead of linear Rec.709, so a finished emulator that expects a log working space (Film Look Creator's Input Color Space DWG / Intermediate) gets what it expects. Ryan's 2026-09-17 note: transform to DWG/Intermediate, emulate, then output. The -idt timeline of this input is log on a linear timeline and is NOT a picture to judge.",
      "clip_input": "Linear",
      "stages": [
        {
          "dctl": "DJI Action 5 D-Log M to DWG",
          "role": "d-log m to dwg intermediate",
          "params": {
            "Output Transfer Function": 0,
            "Output Color Gamut": 0
          }
        }
      ]
    }
  },
  "recipes": {
    "readme-defaults": {
      "why": "Control: the README chain with every Film Curve setting at its default, gain solved.",
      "stages": [
        {
          "dctl": "Clamp",
          "role": "clamp 0+",
          "params": {
            "Min Clamp": 0.0,
            "Clamp Min": 1,
            "Clamp Max": 0
          }
        },
        {
          "dctl": "Film Curve",
          "role": "negative",
          "params": {
            "Red Gamma": 1.0,
            "Red D_MIN": 0.01,
            "Red D_MAX": 4.0,
            "Red Offset": 0.0,
            "Green Gamma": 1.0,
            "Green D_MIN": 0.01,
            "Green D_MAX": 4.0,
            "Green Offset": 0.0,
            "Blue Gamma": 1.0,
            "Blue D_MIN": 0.01,
            "Blue D_MAX": 4.0,
            "Blue Offset": 0.0,
            "Mid Gray": 0.18,
            "Exposure Gain": 1.0,
            "Curve Type": 0
          }
        },
        {
          "dctl": "Multiplication Function",
          "role": "printer lights",
          "params": {
            "Global Gain": "solve"
          }
        },
        {
          "dctl": "Film Curve",
          "role": "print",
          "params": {
            "Red Gamma": 1.0,
            "Red D_MIN": 0.01,
            "Red D_MAX": 4.0,
            "Red Offset": 0.0,
            "Green Gamma": 1.0,
            "Green D_MIN": 0.01,
            "Green D_MAX": 4.0,
